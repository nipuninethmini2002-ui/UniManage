@model IEnumerable<UniManage.Models.Prerequisite>

<div class="container mt-4">
    <div class="card shadow border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0"><i class="fas fa-list-ul me-2"></i> Manage Prerequisites for: @ViewBag.CourseName</h4>
        </div>
        <div class="card-body p-4">

            <div class="bg-light p-3 rounded mb-4">
                <h6 class="text-muted mb-3">Add New Prerequisite</h6>
                @using (Html.BeginForm("AddPrerequisite", "Courses", FormMethod.Post, new { @class = "row g-3 align-items-center" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseId" value="@ViewBag.CourseId" />

                    <div class="col-md-7">
                        <label class="form-label fw-bold">Select Prerequisite Course</label>
                        @Html.DropDownList("PrerequisiteCourseId", (SelectList)ViewBag.OtherCourses, "-- Select Course --", new { @class = "form-select", required = "required" })
                    </div>

                    <div class="col-md-5 mt-4 pt-2">
                        <button type="submit" class="btn btn-primary w-100 shadow-sm">
                            <i class="fas fa-plus-circle"></i> Add Prerequisite
                        </button>
                    </div>
                }
            </div>

            <hr />

            <h5 class="mb-3"><i class="fas fa-info-circle text-info me-2"></i>Current Prerequisites</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70%;">Required Course Name</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center py-4 text-muted">
                                    No prerequisites defined for this course yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 font-weight-bold">
                                        @item.PrerequisiteCourse.CourseName
                                    </td>
                                    <td class="text-center">
                                        @using (Html.BeginForm("RemovePrerequisite", "Courses", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to remove this prerequisite?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="prerequisiteId" value="@item.Id" />
                                            <input type="hidden" name="returnCourseId" value="@ViewBag.CourseId" />

                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash-alt me-1"></i> Remove
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 border-top pt-3">
                <a href="@Url.Action("Index")" class="btn btn-secondary shadow-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back to Course List
                </a>
            </div>
        </div>
    </div>
</div>

@* FontAwesome සඳහා (Icons පේන්නේ නැත්නම් පමණක් මෙය භාවිතා කරන්න) *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
@model IEnumerable<UniManage.Models.CourseReportViewModel>

@{
    ViewBag.Title = "Analytics & System Insights";
}

<style>
    /* Header styling */
    .report-header {
        background: linear-gradient(135deg, #1a2a6c, #2a4858);
        color: white;
        padding: 40px;
        border-radius: 20px;
        margin-bottom: 30px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    /* Stats Cards Styling */
    .stat-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s;
        color: white;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .bg-info-gradient {
        background: linear-gradient(45deg, #17a2b8, #117a8b);
    }

    .bg-success-gradient {
        background: linear-gradient(45deg, #28a745, #1e7e34);
    }

    .bg-primary-gradient {
        background: linear-gradient(45deg, #007bff, #0056b3);
    }

    .bg-warning-gradient {
        background: linear-gradient(45deg, #ffc107, #d39e00);
    }

    .report-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        padding: 30px;
        border: none;
        margin-bottom: 30px;
    }

    .progress {
        height: 12px;
        border-radius: 10px;
        background-color: #f1f3f5;
    }

    .progress-bar {
        background: linear-gradient(to right, #f39c12, #f1c40f);
        border-radius: 10px;
    }

    .course-name {
        font-weight: 700;
        color: #2d3436;
    }

    .count-badge {
        background-color: #eef2f7;
        color: #1a2a6c;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: bold;
    }

    .stat-box {
        border-left: 4px solid #f39c12;
        background: #fff9f0;
        padding: 20px;
        border-radius: 0 10px 10px 0;
        margin-top: 40px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="report-header shadow-lg">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="font-weight-bold mb-1"><i class="fas fa-chart-pie mr-3"></i>Analytics & Reporting Dashboard</h2>
                <p class="opacity-75 mb-0">Real-time System Health & Academic Insights</p>
            </div>
            <div class="col-md-4 text-md-right">
                <button onclick="window.print()" class="btn btn-outline-light btn-sm rounded-pill px-4">
                    <i class="fas fa-print mr-2"></i> Download PDF Report
                </button>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card bg-primary-gradient shadow-sm p-3">
                <div class="d-flex justify-content-between">
                    <div><h6 class="text-uppercase small">Total Students</h6><h3>@ViewBag.StudentCount</h3></div>
                    <i class="fas fa-users fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-success-gradient shadow-sm p-3">
                <div class="d-flex justify-content-between">
                    <div><h6 class="text-uppercase small">Active Enrollments</h6><h3>@ViewBag.TotalEnrollments</h3></div>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-info-gradient shadow-sm p-3">
                <div class="d-flex justify-content-between">
                    <div><h6 class="text-uppercase small">Avg. Course Credits</h6><h3>@string.Format("{0:0.0}", ViewBag.AvgCredits)</h3></div>
                    <i class="fas fa-star fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-warning-gradient shadow-sm p-3">
                <div class="d-flex justify-content-between">
                    <div><h6 class="text-uppercase small">Total Courses</h6><h3>@ViewBag.CourseCount</h3></div>
                    <i class="fas fa-book fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="report-card shadow-sm">
        <h5 class="font-weight-bold mb-4 text-primary">Detailed Course Popularity</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Course Module</th>
                        <th>Student Count</th>
                        <th style="width: 40%;">Enrollment Capacity Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var percentage = item.StudentCount * 10; // Assuming capacity is 10
                        if (percentage > 100) { percentage = 100; }

                        <tr>
                            <td class="course-name">@item.CourseName</td>
                            <td><span class="count-badge">@item.StudentCount Students</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 mr-3">
                                        <div class="progress-bar" role="progressbar" style="width: @percentage%;"></div>
                                    </div>
                                    <span class="small font-weight-bold">@percentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white font-weight-bold">System Counts Overview</div>
                <div class="card-body"><canvas id="mySystemChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white font-weight-bold">Pass vs Fail Ratio</div>
                <div class="card-body"><canvas id="performanceChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white font-weight-bold">Enrollment Share</div>
                <div class="card-body"><canvas id="enrollmentPieChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="stat-box shadow-sm">
        <p class="mb-0 small text-muted">
            <i class="fas fa-info-circle mr-2 text-warning"></i>
            <strong>Compliance Note:</strong> This report utilizes SQL Aggregate functions and LINQ queries for real-time data integrity.
            Generated on: <strong>@DateTime.Now.ToString("f")</strong>
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // 1. Bar Chart: System Overview
            new Chart(document.getElementById('mySystemChart'), {
                type: 'bar',
                data: {
                    labels: ['Students', 'Courses', 'Messages'],
                    datasets: [{
                        label: 'Total Count',
                        data: [@ViewBag.StudentCount, @ViewBag.CourseCount, @ViewBag.MessageCount],
                        backgroundColor: ['#3498db', '#e74c3c', '#1abc9c']
                    }]
                }
            });

            // 2. Doughnut Chart: Academic Performance (Pass/Fail)
            new Chart(document.getElementById('performanceChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Pass', 'Fail'],
                    datasets: [{
                        data: [@ViewBag.PassCount, @ViewBag.FailCount],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                }
            });

            // 3. Pie Chart: Enrollment Distribution
            var courseLabels = @Html.Raw(Json.Encode(ViewBag.CourseNames));
            var enrollmentData = @Html.Raw(Json.Encode(ViewBag.EnrollmentCounts));
            new Chart(document.getElementById('enrollmentPieChart'), {
                type: 'pie',
                data: {
                    labels: courseLabels,
                    datasets: [{
                        data: enrollmentData,
                        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF']
                    }]
                }
            });
        });
    </script>
}
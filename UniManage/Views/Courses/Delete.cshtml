@model UniManage.Models.Course

@{
    ViewBag.Title = "Delete Course";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @* Warning Header *@
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3 animate__animated animate__pulse animate__infinite"></i>
                    <h2 class="font-weight-bold mb-0">Delete Course?</h2>
                    <p class="mb-0 opacity-75">This action cannot be undone.</p>
                </div>

                <div class="card-body p-5">
                    <h4 class="text-center text-muted mb-4">Are you sure you want to permanently delete this course?</h4>

                    <div class="course-details bg-light p-4 rounded-3" style="border-left: 5px solid #dc3545;">
                        <div class="row mb-3">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Course Name</div>
                            <div class="col-sm-8 text-dark fw-bold">@Html.DisplayFor(model => model.CourseName)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Description</div>
                            <div class="col-sm-8 text-secondary">@Html.DisplayFor(model => model.Description)</div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Enrollment Limit</div>
                            <div class="col-sm-8 text-dark">
                                <span class="badge bg-secondary px-3 py-2" style="border-radius: 10px;">
                                    <i class="fas fa-users me-1"></i> @Html.DisplayFor(model => model.EnrollmentLimit) Students
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-actions d-flex justify-content-center align-items-center gap-3">
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2 shadow-sm" style="border-radius: 50px; text-decoration: none;">
                                    <i class="fas fa-times me-1"></i> Cancel, Keep it
                                </a>

                                <button type="submit" class="btn btn-danger px-5 py-2 shadow" style="border-radius: 50px; font-weight: bold;">
                                    <i class="fas fa-trash-alt me-1"></i> YES, DELETE NOW
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <p class="text-center mt-4 text-muted small">
                <i class="fas fa-info-circle me-1"></i> Deleting this course will also remove all associated student enrollments.
            </p>
        </div>
    </div>
</div>

@* FontAwesome for Icons *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<style>
    body {
        background-color: #f8f9fa;
    }

    .course-details {
        background-color: #ffffff !important;
        border: 1px solid #eee;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.02);
    }

    .btn-danger {
        transition: 0.3s;
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #a71d2a;
            transform: scale(1.05);
        }

    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #333;
    }
</style>
@model IEnumerable<UniManage.Models.Submission>

@{
    ViewBag.Title = "Student Submissions";
}

<div class="container" style="margin-top:40px; font-family: 'Segoe UI', sans-serif;">
    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-dark text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-1" style="font-weight: 700;">Assignment Submissions</h3>
                    <p class="mb-0 text-light opacity-75">Review student answers and provide marks with specific feedback.</p>
                </div>
                <span class="badge bg-primary px-3 py-2" style="font-size: 0.9rem;">Total: @Model.Count() Submissions</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="height: 60px;">
                            <th class="ps-4">Student</th>
                            <th>Submission Date</th>
                            <th>Answer File</th>
                            <th class="text-center" style="width: 480px;">Evaluation & Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600; color: #333;">@item.Student.UserName</div>
                                            @if (!string.IsNullOrEmpty(item.Feedback))
                                            {
                                                <span class="badge bg-soft-success text-success p-0" style="font-size: 0.7rem;">
                                                    <i class="fas fa-check-circle me-1"></i> Graded
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-muted" style="font-size: 0.85rem;">
                                        <i class="fas fa-calendar-alt me-1"></i> @item.SubmittedDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    <a href="~/Uploads/Submissions/@item.FileName" download class="btn btn-sm btn-outline-primary px-3" style="border-radius: 20px; font-weight: 500;">
                                        <i class="fas fa-file-download me-1"></i> Download
                                    </a>
                                </td>
                                <td class="py-4 px-3">
                                    @* --- Current Status Display --- *@
                                    <div class="d-flex align-items-start mb-3 p-3 rounded-3 shadow-sm border" style="background-color: #fcfcfc;">
                                        <div class="me-3 text-center border-end pe-3">
                                            <small class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Marks</small>
                                            @if (string.IsNullOrEmpty(item.Grade))
                                            {
                                                <span class="h5 fw-bold text-warning mb-0">--</span>
                                            }
                                            else
                                            {
                                                <span class="h5 fw-bold text-primary mb-0">@item.Grade</span>
                                            }
                                        </div>

                                        <div class="flex-grow-1 ps-2">
                                            <small class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Feedback</small>
                                            @if (string.IsNullOrEmpty(item.Feedback))
                                            {
                                                <span class="text-muted italic small">No feedback provided yet.</span>
                                            }
                                            else
                                            {
                                                <div class="text-dark" style="font-size: 0.88rem; line-height: 1.4;">
                                                    "@item.Feedback"
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* --- Edit Button & Collapsible Form --- *@
                                    <div class="text-end">
                                        <button class="btn btn-sm btn-dark px-3 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editForm-@item.SubmissionId" style="border-radius: 8px; font-size: 0.8rem;">
                                            <i class="fas fa-edit me-1"></i> Edit/Give Marks
                                        </button>
                                    </div>

                                    <div class="collapse mt-3" id="editForm-@item.SubmissionId">
                                        @using (Html.BeginForm("GiveGrade", "Submissions", FormMethod.Post, new { @class = "p-3 border rounded-3 bg-white shadow" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@item.SubmissionId" />

                                            <div class="row g-2">
                                                <div class="col-md-3">
                                                    <label class="small fw-bold text-muted">New Marks</label>
                                                    <input type="text" name="grade" value="@item.Grade" class="form-control form-control-sm" placeholder="e.g. 85" required />
                                                </div>
                                                <div class="col-md-9">
                                                    <label class="small fw-bold text-muted">Update Feedback</label>
                                                    <textarea name="feedback" class="form-control form-control-sm" rows="2" placeholder="Write something helpful...">@item.Feedback</textarea>
                                                </div>
                                                <div class="col-12 mt-2">
                                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">
                                                        <i class="fas fa-save me-1"></i> Update Evaluation
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Font Awesome Icons *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .italic {
        font-style: italic;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.3s;
    }

    .bg-soft-success {
        background-color: #e8f5e9;
        padding: 2px 8px;
        border-radius: 10px;
    }

    .card {
        border: none;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .btn-dark {
        background-color: #212529;
        border: none;
    }

        .btn-dark:hover {
            background-color: #000;
        }
</style>
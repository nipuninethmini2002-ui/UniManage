@model IEnumerable<UniManage.Models.CourseMaterial>

@{
    ViewBag.Title = "Course Materials";
}

<div class="container" style="margin-top:40px; font-family: 'Segoe UI', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #2c3e50; font-weight: 700;"><i class="fas fa-book-reader text-primary me-2"></i> Course Materials</h2>
            <p class="text-muted">Access and manage all educational resources and lecture notes.</p>
        </div>

        @if (User.IsInRole("Lecturer") || User.IsInRole("Admin"))
        {
            <a href="@Url.Action("Create", "Materials")" class="btn btn-primary shadow-sm" style="border-radius: 10px; padding: 10px 20px;">
                <i class="fas fa-plus-circle me-1"></i> Upload New Material
            </a>
        }
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead style="background-color: #f8f9fa; color: #495057; border-bottom: 2px solid #eee;">
                        <tr>
                            <th class="ps-4 py-3">Material Title</th>
                            <th class="py-3">Description</th>
                            <th class="py-3 text-center">Upload Date</th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted font-italic">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block text-light"></i>
                                    No materials available yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-soft-primary text-primary rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #eef2f7;">
                                                <i class="fas fa-file-pdf fa-lg"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.Title</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted" style="max-width: 300px;">
                                        @(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge bg-light text-dark border p-2" style="font-weight: 500;">
                                            <i class="far fa-calendar-alt me-1 text-primary"></i> @item.UploadDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="btn-group shadow-sm" role="group">
                                            @* 1. Download Button *@
                                            <a href="@Url.Action("DownloadFile", "Materials", new { id = item.MaterialId })" class="btn btn-sm btn-light text-primary" title="Download Material">
                                                <i class="fas fa-download"></i> <span class="d-none d-md-inline ms-1">Download</span>
                                            </a>

                                            @if (User.IsInRole("Lecturer") || User.IsInRole("Admin"))
                                            {
                                                @* 2. Edit Button *@
                                                <a href="@Url.Action("Edit", "Materials", new { id = item.MaterialId })" class="btn btn-sm btn-light text-warning" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                @* 3. Delete Button *@
                                                using (Html.BeginForm("Delete", "Materials", new { id = item.MaterialId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this material?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* FontAwesome Link (සමහරවිට layout එකේ දැනටමත් ඇති) *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .table-hover tbody tr:hover {
        background-color: #f8fbff;
        transition: 0.2s ease-in-out;
    }

    .btn-group .btn {
        border: 1px solid #eee;
        padding: 8px 15px;
        background: #fff;
    }

        .btn-group .btn:hover {
            background-color: #f1f3f5;
            z-index: 2;
        }

    .bg-soft-primary {
        transition: 0.3s;
    }

    tr:hover .bg-soft-primary {
        background-color: #007bff !important;
        color: white !important;
    }

    .card {
        border: none;
    }

    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>
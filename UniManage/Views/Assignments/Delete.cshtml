@model UniManage.Models.Assignment

@{
    ViewBag.Title = "Delete Assignment";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @* Warning Header *@
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="fas fa-file-excel fa-3x mb-3 animate__animated animate__shakeX"></i>
                    <h2 class="font-weight-bold mb-0">Delete Assignment?</h2>
                    <p class="mb-0 opacity-75">This will permanently remove the assignment for all students.</p>
                </div>

                <div class="card-body p-5">
                    <h4 class="text-center text-muted mb-4">Are you sure you want to delete this assignment?</h4>

                    <div class="assignment-details bg-light p-4 rounded-3" style="border-left: 5px solid #dc3545;">
                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Course</div>
                            <div class="col-sm-8 text-primary fw-bold">@Html.DisplayFor(model => model.Course.CourseName)</div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Assignment Title</div>
                            <div class="col-sm-8 text-dark fw-bold">@Html.DisplayFor(model => model.Title)</div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Description</div>
                            <div class="col-sm-8 text-secondary small">@Html.DisplayFor(model => model.Description)</div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-sm-4 font-weight-bold text-uppercase small text-muted">Submission Deadline</div>
                            <div class="col-sm-8">
                                <span class="badge bg-warning text-dark px-3 py-2" style="border-radius: 10px;">
                                    <i class="far fa-calendar-times me-1"></i> @Html.DisplayFor(model => model.Deadline)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-actions d-flex justify-content-center align-items-center gap-3">
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2 shadow-sm" style="border-radius: 50px; text-decoration: none;">
                                    <i class="fas fa-arrow-left me-1"></i> No, Go Back
                                </a>

                                <button type="submit" class="btn btn-danger px-5 py-2 shadow" style="border-radius: 50px; font-weight: bold;">
                                    <i class="fas fa-trash-alt me-1"></i> CONFIRM DELETE
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <p class="text-center mt-4 text-muted small">
                <i class="fas fa-exclamation-circle me-1"></i> Note: Student submissions for this assignment will also be removed.
            </p>
        </div>
    </div>
</div>

@* FontAwesome & Animation Library *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<style>
    body {
        background-color: #f8f9fa;
    }

    .assignment-details {
        background-color: #ffffff !important;
        border: 1px solid #eee;
        box-shadow: inset 0 0 15px rgba(0,0,0,0.02);
    }

    .btn-danger {
        transition: 0.3s;
        background: linear-gradient(135deg, #dc3545, #c82333);
        border: none;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c82333, #a71d2a);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }

    .btn-outline-secondary {
        border-radius: 50px;
        transition: 0.3s;
    }

    .badge {
        font-size: 0.9rem;
    }
</style>
@model UniManage.Models.Assignment

@{
    ViewBag.Title = "Submit Assignment";
}

<div class="container mt-5" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                @* Header *@
                <div class="card-header bg-primary text-white py-4 text-center" style="border-radius: 15px 15px 0 0;">
                    <h3 class="mb-0"><i class="fas fa-cloud-upload-alt me-2"></i> Submit Assignment</h3>
                    <p class="mb-0 opacity-75">Course ID: @ViewBag.CourseId</p>
                </div>

                <div class="card-body p-5">
                    @* සාර්ථක හෝ අසාර්ථක පණිවිඩ පෙන්වීමට *@
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px;">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @* Form ආරම්භය *@
                    @using (Html.BeginForm("Submit", "Assignment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("courseId", (int)ViewBag.CourseId)

                        <div class="text-center mb-4">
                            <div class="upload-area p-5 border-2 border-dashed rounded-3 shadow-sm bg-light" id="uploadArea">
                                <i class="fas fa-file-archive fa-3x text-primary mb-3"></i>
                                <h5>Select your assignment file</h5>
                                <p class="text-muted small">Allowed formats: PDF, Word, or Images</p>

                                <div class="mt-3">
                                    <input type="file" name="uploadFile" id="uploadFile" class="form-control" required style="border-radius: 8px;" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            @Html.ActionLink("Back to Courses", "MyCourses", "Enrollment", null, new { @class = "btn btn-outline-secondary px-4", style = "border-radius: 8px;" })

                            <button type="submit" class="btn btn-primary px-5 shadow" style="border-radius: 8px; font-weight: 600;">
                                <i class="fas fa-check-circle me-1"></i> Upload & Submit
                            </button>
                        </div>
                    }
                </div>

                @* Footer/Note *@
                <div class="card-footer bg-light py-3 border-0 text-center" style="border-radius: 0 0 15px 15px;">
                    <small class="text-muted"><i class="fas fa-info-circle me-1"></i> Please ensure you are uploading the correct version of your work.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@* FontAwesome සහ වැඩිදුර Styles *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background-color: #f0f2f5;
    }

    .upload-area {
        border: 2px dashed #dee2e6;
        transition: all 0.3s ease;
    }

        .upload-area:hover {
            border-color: #4e73df;
            background-color: #f8f9fc !important;
        }

    .btn-primary {
        background-color: #4e73df;
        border: none;
        transition: 0.3s;
    }

        .btn-primary:hover {
            background-color: #224abe;
            transform: translateY(-2px);
        }

    /* Form control focus effect */
    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }
</style>
@model UniManage.Models.Assignment

@{
    ViewBag.Title = "Create Assignment";
}

<div class="container" style="margin-top:40px; font-family: 'Segoe UI', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0" style="border-radius: 15px;">
                <div class="card-header bg-primary text-white text-center py-4" style="border-radius: 15px 15px 0 0;">
                    <h3 class="mb-0"><i class="fas fa-file-upload me-2"></i> Create New Assignment</h3>
                    <p class="mb-0 mt-2 opacity-75">Fill in the details below to publish a new assignment</p>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Assignments", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            @* Title *@
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold"><i class="fas fa-heading me-1 text-primary"></i> Assignment Title</label>
                                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. Introduction to MVC Quiz", style = "border-radius: 8px;" } })
                                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger small" })
                            </div>

                            @* Course Selection *@
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="fas fa-graduation-cap me-1 text-primary"></i> Select Course</label>
                                @Html.DropDownList("CourseId", null, "-- Select Course --", htmlAttributes: new { @class = "form-select", style = "border-radius: 8px;" })
                                @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger small" })
                            </div>

                            @* Deadline *@
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="fas fa-calendar-alt me-1 text-primary"></i> Submission Deadline</label>
                                @Html.EditorFor(model => model.Deadline, new { htmlAttributes = new { @class = "form-control", type = "datetime-local", style = "border-radius: 8px;" } })
                                @Html.ValidationMessageFor(model => model.Deadline, "", new { @class = "text-danger small" })
                            </div>

                            @* File Upload *@
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold"><i class="fas fa-paperclip me-1 text-primary"></i> Upload Reference Material (Optional)</label>
                                <div class="input-group">
                                    <input type="file" name="upload" class="form-control" style="border-radius: 8px;" />
                                </div>
                                <small class="text-muted">PDF, Word or ZIP files only.</small>
                            </div>

                            @* Description *@
                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-bold"><i class="fas fa-align-left me-1 text-primary"></i> Instructions / Description</label>
                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "4", placeholder = "Describe what students need to do...", style = "border-radius: 8px;" })
                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Index")" class="btn btn-light px-4" style="border-radius: 8px;">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm" style="border-radius: 8px; font-weight: 600;">
                                <i class="fas fa-plus-circle me-1"></i> Create Assignment
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
}

<style>
    body {
        background-color: #f8f9fc;
    }

    .card {
        transition: 0.3s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .btn-primary {
        background-color: #4e73df;
        border: none;
    }

        .btn-primary:hover {
            background-color: #224abe;
        }
</style>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@model IEnumerable<UniManage.Models.Course>

@{
    ViewBag.Title = "Available Courses";
}

<div class="container" style="margin-top:40px; font-family: 'Segoe UI', sans-serif;">
    <div class="text-center mb-5">
        <h2 style="color: #2c3e50; font-weight: 800; letter-spacing: -1px;">Explore Our Courses</h2>
        <p class="text-muted">Find the perfect course to advance your skills and knowledge.</p>
        <div style="width: 60px; height: 4px; background: #4e73df; margin: 0 auto; border-radius: 2px;"></div>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No courses are available at the moment. Please check back later.</p>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 course-card" style="border-radius: 15px; transition: transform 0.3s ease;">
                        @* Course එකේ Icon එකක් හෝ Default Image එකක් *@
                        <div class="card-header border-0 text-center pt-4" style="background: transparent;">
                            <div class="icon-box mx-auto shadow-sm" style="width: 70px; height: 70px; background: #f8f9fc; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-book-open fa-2x text-primary"></i>
                            </div>
                        </div>

                        <div class="card-body text-center px-4">
                            <h5 class="card-title" style="color: #34495e; font-weight: 700; min-height: 50px;">
                                @item.CourseName
                            </h5>
                            <p class="card-text text-muted" style="font-size: 0.9rem; line-height: 1.6;">
                                @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            </p>
                        </div>

                        @using (Html.BeginForm("Enroll", "Enrollment", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <button type="submit" class="btn btn-primary shadow-sm" style="border-radius: 20px;">
                                <i class="fas fa-user-plus"></i> Enroll Now
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@* FontAwesome Link *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .course-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

    .btn-primary {
        background-color: #4e73df;
        border: none;
        transition: 0.3s;
    }

        .btn-primary:hover {
            background-color: #224abe;
            transform: scale(1.02);
        }

    .icon-box {
        transition: 0.3s;
    }

    .course-card:hover .icon-box {
        background: #4e73df !important;
    }

        .course-card:hover .icon-box i {
            color: white !important;
        }
</style>
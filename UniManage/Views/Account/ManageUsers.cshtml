@model IEnumerable<UniManage.Models.ApplicationUser>

@{
    ViewBag.Title = "System User Management";

    // Role IDs (ඔබේ Database එකට අනුව)
    var studentRoleId = "c420413f-edc9-48e1-b705-d63880c8c449";
    var lecturerRoleId = "4fca5ead-790a-4a44-93d9-a59f9f459fac";

    // දත්ත වෙන් කරගැනීම
    var students = Model.Where(u => u.Roles.Any(r => r.RoleId == studentRoleId)).ToList();
    var lecturers = Model.Where(u => u.Roles.Any(r => r.RoleId == lecturerRoleId)).ToList();

    // Admin හැර සැබෑ මුළු එකතුව (Students + Lecturers පමණක්)
    var actualTotalCount = students.Count + lecturers.Count;
}

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="text-primary fw-bold" style="margin-top:0;">
                <i class="fas fa-users-cog"></i> System User Management
            </h2>
            <p class="text-muted">
                Total Registration: <strong>@actualTotalCount</strong>
                (Students: <span class="badge bg-primary">@students.Count</span> |
                Lecturers: <span class="badge bg-info text-dark">@lecturers.Count</span>)
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Register", "Account")" class="btn btn-success shadow-sm fw-bold rounded-pill px-4">
                <i class="fas fa-user-plus"></i> Register New User
            </a>
        </div>
    </div>

    <ul class="nav nav-pills mb-4 shadow-sm p-2 bg-dark rounded-pill justify-content-center" id="userTabs" role="tablist">
        <li class="nav-item active" role="presentation" style="margin: 0 5px;">
            <a class="nav-link active rounded-pill px-5 fw-bold" id="students-tab" data-bs-toggle="pill" data-toggle="pill" href="#students" role="tab" aria-selected="true">
                <i class="fas fa-user-graduate me-2"></i> All Students (@students.Count)
            </a>
        </li>
        <li class="nav-item" role="presentation" style="margin: 0 5px;">
            <a class="nav-link rounded-pill px-5 fw-bold text-white bg-secondary" id="lecturers-tab" data-bs-toggle="pill" data-toggle="pill" href="#lecturers" role="tab" aria-selected="false">
                <i class="fas fa-chalkboard-teacher me-2"></i> All Lecturers (@lecturers.Count)
            </a>
        </li>
    </ul>

    <div class="card mb-4 border-0 shadow-sm rounded-4" style="background: #f1f3f5; border: 1px solid #ddd !important;">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                <input type="text" id="globalSearch" class="form-control border-start-0 py-2" placeholder="Quick search by name..." autocomplete="off">
            </div>
        </div>
    </div>

    <div class="tab-content" id="userTabsContent">

        <div class="tab-pane fade active in show" id="students" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden border-primary" style="border-left: 5px solid #0d6efd !important;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th class="ps-4">Student Name</th>
                            <th>Email Address</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in students)
                        {
                            <tr class="user-row">
                                <td class="ps-4">
                                    <div style="display:flex; align-items:center;">
                                        <div class="avatar-circle bg-primary">@user.UserName.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <span class="fw-bold text-dark d-block user-name">@user.UserName</span>
                                            <small class="text-muted">ID: @user.Id.Substring(0, 8)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Edit", "Account", new { id = user.Id })" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@user.Id')" title="Delete"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="lecturers" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden border-info" style="border-left: 5px solid #0dcaf0 !important;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-info text-dark">
                        <tr>
                            <th class="ps-4">Lecturer Name</th>
                            <th>Email Address</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in lecturers)
                        {
                            <tr class="user-row">
                                <td class="ps-4">
                                    <div style="display:flex; align-items:center;">
                                        <div class="avatar-circle bg-info text-white">@user.UserName.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <span class="fw-bold text-dark d-block user-name">@user.UserName</span>
                                            <small class="text-muted">Staff ID: @user.Id.Substring(0, 8)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Edit", "Account", new { id = user.Id })" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@user.Id')" title="Delete"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live Search Logic
        document.getElementById('globalSearch').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let activePane = document.querySelector('.tab-pane.active');
            let rows = activePane.querySelectorAll('.user-row');

            rows.forEach(row => {
                let nameElement = row.querySelector('.user-name');
                if (nameElement) {
                    let name = nameElement.textContent.toLowerCase();
                    row.style.display = name.includes(filter) ? "" : "none";
                }
            });
        });

        function confirmDelete(userId) {
            if (confirm('Are you sure you want to delete this user? This cannot be undone.')) {
                // Delete logic can be implemented here
                console.log("Deleting user: " + userId);
            }
        }
    </script>
}

<style>
    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 12px;
        font-size: 14px;
    }
    /* Buttons වර්ණය වැඩි දියුණු කිරීම */
    .nav-pills .nav-link {
        color: white !important;
        transition: 0.3s;
        border: 1px solid transparent;
        opacity: 0.7;
    }

        .nav-pills .nav-link.active {
            background-color: #0d6efd !important;
            opacity: 1;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.4);
        }

        .nav-pills .nav-link:hover {
            opacity: 1;
            background-color: rgba(255,255,255,0.1);
        }

    .bg-dark {
        background-color: #343a40 !important;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .table thead th {
        border: none;
        padding: 1.2rem;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .btn-group .btn {
        margin: 0 2px;
    }
</style>
@using UniManage.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
}

<style>
    /* පිටුවේ සම්පූර්ණ උස පාලනය */
    .full-height-login {
        min-height: calc(100vh - 100px); /* Navbar එකට ඉඩ තබා ඉතිරි උස */
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 20px;
    }

    .login-card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        display: flex;
        width: 100%;
        max-width: 900px;
    }

    /* වම් පැත්ත - Form එක */
    .login-form-side {
        flex: 1;
        padding: 40px;
        background: #ffffff;
    }

    /* දකුණු පැත්ත - Image එක */
    .login-image-side {
        flex: 1;
        background: linear-gradient(rgba(0, 114, 255, 0.7), rgba(0, 198, 255, 0.7)), url('https://images.unsplash.com/photo-1541339907198-e08756defe13?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80');
        background-size: cover;
        background-position: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 30px;
        text-align: center;
    }

    .brand-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .btn-login-custom {
        background: linear-gradient(to right, #0072ff, #00c6ff);
        border: none;
        border-radius: 25px;
        color: white;
        font-weight: bold;
        padding: 12px;
        transition: 0.3s;
    }

        .btn-login-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 114, 255, 0.3);
            color: white;
        }

    /* Input styling */
    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .form-control-custom {
        border-left: none;
    }

    /* Navbar එකට යටින් background එකක් අවශ්‍ය නම් */
    body {
        background-color: #f4f7f6;
    }
</style>

<div class="container full-height-login">
    <div class="login-card-custom">

        <div class="login-form-side">
            <h3 class="text-primary font-weight-bold">Welcome Back!</h3>
            <p class="text-muted mb-4">Please login to your account</p>

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group mb-3">
                    <label class="small font-weight-bold">User Name</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-user text-primary"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control form-control-custom", placeholder = "johndoe123" })
                    </div>
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-3">
                    <label class="small font-weight-bold">Password</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-lock text-primary"></i></span>
                        </div>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-custom", placeholder = "********" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="custom-control custom-checkbox mb-4">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "custom-control-input", id = "customCheck1" })
                    <label class="custom-control-label small text-muted" for="customCheck1">Remember me</label>
                </div>

                <button type="submit" class="btn btn-login-custom btn-block shadow-sm">LOG IN</button>
                <div class="text-center mt-4">
                    @Html.ActionLink("Forgot password?", "ForgotPassword", null, new { @class = "small text-primary" })
                    <p class="small text-muted">
                        Don't have an account?
                        @Html.ActionLink("Register Now", "Register", null, new { @class = "font-weight-bold" })
                    </p>
                </div>
            }
        </div>

        <div class="login-image-side d-none d-md-flex">
            <i class="fas fa-user-graduate brand-icon"></i>
            <h2 class="font-weight-bold">UniManage</h2>
            <p class="px-4">"Education is the passport to the future, for tomorrow belongs to those who prepare for it today."</p>
            <div class="mt-3">
                <span class="badge badge-light p-2">v3.0 Secure Access</span>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
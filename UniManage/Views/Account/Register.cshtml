@model UniManage.Models.RegisterViewModel
@{
    ViewBag.Title = "Create Account";
}

<style>
    /* පිටුවේ සම්පූර්ණ උස පාලනය */
    .full-height-register {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }

    .register-card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        display: flex;
        width: 100%;
        max-width: 1000px;
    }

    /* වම් පැත්ත - Form එක */
    .register-form-side {
        flex: 1.2;
        padding: 40px;
        background: #ffffff;
    }

    /* දකුණු පැත්ත - Image එක */
    .register-image-side {
        flex: 1;
        background: linear-gradient(rgba(102, 126, 234, 0.8), rgba(118, 75, 162, 0.8)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80');
        background-size: cover;
        background-position: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 30px;
        text-align: center;
    }

    .brand-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .btn-register-custom {
        background: linear-gradient(to right, #667eea, #764ba2);
        border: none;
        border-radius: 25px;
        color: white;
        font-weight: bold;
        padding: 12px;
        transition: 0.3s;
        width: 100%;
        margin-top: 10px;
    }

        .btn-register-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .form-control-custom {
        border-left: none;
    }

    body {
        background-color: #f4f7f6;
    }

    .form-group label {
        font-size: 0.85rem;
    }

    /* Course selection එකට පොඩි animation එකක් */
    #courseSelectionArea {
        transition: all 0.4s ease;
        background: #f0f2ff;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 15px;
        border-left: 4px solid #667eea;
    }
</style>

<div class="container full-height-register">
    <div class="register-card-custom">

        <div class="register-form-side">
            <h3 class="text-primary font-weight-bold">Join UniManage</h3>
            <p class="text-muted mb-4">Create your account to start learning</p>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger small" })

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="small font-weight-bold">User Name</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-id-badge text-primary"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control form-control-custom", placeholder = "johndoe123" })
                        </div>
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="small font-weight-bold">Phone Number</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-phone text-primary"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control form-control-custom", placeholder = "0712345678" })
                        </div>
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-12 form-group mb-3">
                        <label class="small font-weight-bold">Email Address</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-envelope text-primary"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-custom", placeholder = "example@uni.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="small font-weight-bold">Password</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-lock text-primary"></i></span>
                            </div>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-custom", placeholder = "********" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="small font-weight-bold">Confirm Password</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-check-circle text-primary"></i></span>
                            </div>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control form-control-custom", placeholder = "********" })
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-12 form-group mb-3">
                        <label class="small font-weight-bold">I am a...</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-user-tag text-primary"></i></span>
                            </div>
                            @Html.DropDownListFor(m => m.UserRole, new SelectList(new[] { "Student", "Lecturer" }), "--- Select Your Role ---", new { @class = "form-control form-control-custom", id = "UserRole" })
                        </div>
                        @Html.ValidationMessageFor(m => m.UserRole, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div id="courseSelectionArea" style="display:none;">
                    <label class="small font-weight-bold">Assign to Course</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-book text-primary"></i></span>
                        </div>
                        @Html.DropDownListFor(m => m.SelectedCourseId, (SelectList)ViewBag.CourseList, "--- Select Your Course ---", new { @class = "form-control form-control-custom" })
                    </div>
                    <small class="text-muted mt-1 d-block">As a lecturer, please select your primary course.</small>
                </div>

                <button type="submit" class="btn btn-register-custom shadow-sm mt-3">CREATE ACCOUNT</button>

                <div class="text-center mt-4">
                    <p class="small text-muted">
                        Already have an account?
                        @Html.ActionLink("Login Here", "Login", null, new { @class = "font-weight-bold text-primary" })
                    </p>
                </div>
            }
        </div>

        <div class="register-image-side d-none d-md-flex">
            <i class="fas fa-book-reader brand-icon"></i>
            <h2 class="font-weight-bold">Start Your Journey</h2>
            <p class="px-4">"The beautiful thing about learning is that no one can take it away from you."</p>
            <div class="mt-3">
                <span class="badge badge-light p-2">Join 5000+ Students</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script type="text/javascript">
        $(document).ready(function () {
            // Dropdown එක වෙනස් වන විට trigger වේ
            $('#UserRole').change(function () {
                var selectedRole = $(this).val();
                if (selectedRole === "Lecturer") {
                    $('#courseSelectionArea').fadeIn(); // අලංකාර ලෙස පෙන්වීමට fadeIn පාවිච්චි කළා
                } else {
                    $('#courseSelectionArea').fadeOut();
                }
            });

            // Page එක reload වුණොත් (Validation error එකකදී වැනි) කලින් තේරූ අගය අනුව පෙන්වීමට
            if ($('#UserRole').val() === "Lecturer") {
                $('#courseSelectionArea').show();
            }
        });
    </script>
}
@model UniManage.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
}

<style>
    .full-height-forgot {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .forgot-card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        display: flex;
        width: 100%;
        max-width: 850px;
    }

    /* වම් පැත්ත - Form එක */
    .forgot-form-side {
        flex: 1.2;
        padding: 50px;
        background: #ffffff;
    }

    /* දකුණු පැත්ත - Visual එක */
    .forgot-visual-side {
        flex: 1;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 30px;
        text-align: center;
    }

    .btn-forgot-custom {
        background: linear-gradient(to right, #f093fb, #f5576c);
        border: none;
        border-radius: 25px;
        color: white;
        font-weight: bold;
        padding: 12px;
        transition: 0.3s;
        width: 100%;
        margin-top: 10px;
    }

        .btn-forgot-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
            color: white;
        }

    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .form-control-custom {
        border-left: none;
    }

    .back-to-login {
        margin-top: 25px;
        display: block;
        font-size: 0.9rem;
    }

    body {
        background-color: #f4f7f6;
    }
</style>

<div class="container full-height-forgot">
    <div class="forgot-card-custom">

        <div class="forgot-form-side">
            <h3 class="font-weight-bold text-dark">Password Recovery</h3>
            <p class="text-muted mb-4">No worries! Enter your email address and we'll send you a link to reset your password.</p>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger small" })

                <div class="form-group mb-4">
                    <label class="small font-weight-bold">Registered Email</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-paper-plane text-danger"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-custom", placeholder = "yourname@example.com" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-forgot-custom shadow-sm">SEND RESET LINK</button>

                <div class="text-center back-to-login">
                    <a href="@Url.Action("Login", "Account")" class="text-muted font-weight-bold">
                        <i class="fa fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            }
        </div>

        <div class="forgot-visual-side d-none d-md-flex">
            <i class="fas fa-key fa-5x mb-4"></i>
            <h2 class="font-weight-bold">Secure Access</h2>
            <p class="px-3">Protecting your account is our top priority. We use encrypted links for all password resets.</p>
        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
@model UniManage.Models.UserMessage

@{
    ViewBag.Title = "Compose Message";
}

<style>
    /* Gradient Header for Messaging */
    .compose-header {
        background: linear-gradient(135deg, #1a2a6c, #2a4858);
        color: white;
        padding: 50px 20px;
        border-radius: 20px;
        margin-bottom: -60px;
        position: relative;
        z-index: 1;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    /* Form Card Container */
    .compose-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        padding: 80px 45px 45px 45px;
        position: relative;
        z-index: 2;
        border: none;
    }

    /* Customizing Input Fields */
    .form-control-custom {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #dee2e6;
        transition: 0.3s;
        background-color: #fcfcfc;
    }

        .form-control-custom:focus {
            border-color: #f39c12; /* Gold focus */
            background-color: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(243, 156, 18, 0.1);
        }

    .field-label {
        font-weight: 700;
        color: #1a2a6c;
        margin-bottom: 8px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Send Button Styling */
    .btn-send {
        background: linear-gradient(to right, #1a2a6c, #2a4858);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 12px 40px;
        font-weight: bold;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-send:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(26, 42, 108, 0.3);
            color: #f39c12; /* Text turns gold on hover */
        }

    .btn-discard {
        color: #636e72;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-discard:hover {
            color: #d63031;
            text-decoration: none;
        }

    .input-icon {
        position: relative;
    }

        .input-icon i {
            position: absolute;
            right: 15px;
            top: 40px;
            color: #b2bec3;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="compose-header text-center">
                <i class="fas fa-paper-plane fa-3x mb-3 text-warning"></i>
                <h2 class="font-weight-bold">Compose Message</h2>
                <p class="opacity-75">Send an internal message to another user in the UniManage system.</p>
            </div>

            <div class="compose-card">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small" })

                    <div class="form-group mb-4 input-icon">
                        <label class="field-label">Recipient (To:)</label>
                        @Html.DropDownList("ReceiverId", (SelectList)ViewBag.Receivers, "--- Select User ---", new { @class = "form-control form-control-custom" })
                        <i class="fas fa-address-book"></i>
                        @Html.ValidationMessage("ReceiverId", "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group mb-4 input-icon">
                        <label class="field-label">Subject</label>
                        @Html.EditorFor(m => m.Subject, new { htmlAttributes = new { @class = "form-control form-control-custom", placeholder = "Enter message subject..." } })
                        <i class="fas fa-pen-nib"></i>
                        @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group mb-4">
                        <label class="field-label">Message Content</label>
                        @Html.TextAreaFor(m => m.Content, new { @class = "form-control form-control-custom", rows = 6, placeholder = "Type your message here..." })
                        @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger small" })
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Inbox")" class="btn-discard">
                            <i class="fas fa-times-circle mr-1"></i> Discard
                        </a>
                        <button type="submit" class="btn btn-send shadow">
                            <i class="fas fa-paper-plane mr-2"></i> SEND MESSAGE
                        </button>
                    </div>
                }
            </div>

            <p class="text-center mt-4 text-muted small">
                Communication Portal - UniManage System v2.0
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
@model UniManage.Models.UserMessage

@{
    ViewBag.Title = "Message Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="text-primary mb-0"><i class="fas fa-envelope-open-text mr-2"></i> Message Details</h4>
                        <a href="@Url.Action("Inbox")" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Inbox
                        </a>
                    </div>
                </div>
                <div class="card-body px-5">
                    <div class="mb-4">
                        <small class="text-muted text-uppercase font-weight-bold">Subject</small>
                        <h3 class="font-weight-bold">@Model.Subject</h3>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase font-weight-bold">From</small>
                            <p class="mb-0 text-dark">@Model.Sender.UserName</p>
                        </div>
                        <div class="col-sm-6 text-sm-right">
                            <small class="text-muted text-uppercase font-weight-bold">Date Received</small>
                            <p class="mb-0 text-dark">@Model.SentDate.ToString("f")</p>
                        </div>
                    </div>

                    <hr />

                    <div class="py-3" style="min-height: 150px; white-space: pre-wrap;">
                        @Model.Content
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">
                        @using (Html.BeginForm("Delete", "Messages", new { id = Model.MessageId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this message?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-4" style="border-radius: 50px;">
                                <i class="fas fa-trash-alt mr-2"></i> Delete Message
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<UniManage.Models.UserMessage>

@{
    ViewBag.Title = "All System Messages";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-envelope-open-text mr-2"></i> All System Messages (Admin View)</h4>
            <span class="badge badge-warning">Total: @Model.Count()</span>
        </div>
        <div class="card-body">
            <table class="table table-hover mt-3">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 15%;">Date</th>
                        <th style="width: 15%;">Sender</th>
                        <th style="width: 15%;">Receiver</th>
                        <th style="width: 20%;">Subject</th>
                        <th style="width: 35%;">Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SentDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Sender.UserName</td>
                            <td>@item.Receiver.UserName</td>
                            <td><strong>@item.Subject</strong></td>
                            <td>@item.Content</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
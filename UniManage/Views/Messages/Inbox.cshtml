@model IEnumerable<UniManage.Models.UserMessage>

@{
    ViewBag.Title = "Inbox";
}

<style>
    /* Message Dashboard Header */
    .message-header {
        background: linear-gradient(135deg, #1a2a6c, #2a4858);
        color: white;
        padding: 40px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    /* Inbox Container */
    .inbox-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        padding: 0;
        overflow: hidden;
        border: none;
    }

    /* Table Styles */
    .table thead {
        background-color: #f8f9fa;
        color: #1a2a6c;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .message-row {
        transition: 0.2s;
        cursor: pointer;
    }

        .message-row:hover {
            background-color: #f0f4f8 !important;
        }

    /* Custom Labels */
    .sender-name {
        font-weight: 700;
        color: #1a2a6c;
    }

    .subject-text {
        font-weight: 600;
        color: #2d3436;
    }

    .content-preview {
        color: #636e72;
        display: inline-block;
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .date-badge {
        font-size: 0.75rem;
        color: #b2bec3;
    }

    /* Action Buttons */
    .btn-compose {
        background: #f39c12;
        color: white;
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

        .btn-compose:hover {
            background: #e67e22;
            color: white;
            transform: translateY(-2px);
        }

    .action-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        margin: 0 2px;
        font-size: 0.85rem;
    }
</style>

<div class="container mt-4">
    <div class="message-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="font-weight-bold mb-1"><i class="fas fa-inbox mr-3"></i> Messages</h2>
            <p class="mb-0 opacity-75">Keep track of your conversations with students and faculty.</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-compose shadow">
            <i class="fas fa-paper-plane mr-2"></i> COMPOSE NEW
        </a>
    </div>

    <div class="inbox-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="pl-4">From</th>
                        <th>Subject & Message</th>
                        <th>Sent Date</th>
                        <th class="text-right pr-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="message-row">
                            <td class="pl-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle mr-3" style="width: 35px; height: 35px; background: #eef2f7; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-user text-primary" style="font-size: 0.9rem;"></i>
                                    </div>
                                    <span class="sender-name">@item.SenderId</span>
                                </div>
                            </td>
                            <td>
                                <div class="subject-text">@item.Subject</div>
                                <div class="content-preview small">@item.Content</div>
                            </td>
                            <td>
                                <span class="date-badge"><i class="far fa-clock mr-1"></i> @item.SentDate</span>
                            </td>
                            <td class="text-right pr-4">
                                <a href="@Url.Action("Details","Messages", new { id = item.MessageId })" class="action-icon btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-envelope-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">Your inbox is empty. No messages yet.</p>
            </div>
        }
    </div>
</div>